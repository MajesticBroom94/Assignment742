@model List<MessageHistoryViewModel>

@{
    ViewBag.Title = "Message Center";
    if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        Layout = "_AdminLayout";    
    }
    else if (User.IsInRole("Host"))
    {
        Layout = "_HostLayout";
    }
    else
    {
        Layout = "_GuestLayout";
    }
}

<link rel="stylesheet" href="~/css/messagesHome.css">

<div class="msg-contact-page-header">
    <div>
        <h3>Message Center</h3>
        <p>All your messages in one place</p>
    </div>

    <span class="contact-count">
        <i class="fa-regular fa-comments"></i>
        @(Model.Count == 1 ? Model.Count + " chat" : Model.Count + " chats" )  
    </span>
</div>

<div class="container" style="max-width: 750px;">
    <div class="card shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom p-4">
            <h3 class="mb-1">Messages</h3>
            <p class="text-muted mb-0">Your conversations</p>
        </div>

        @if(Model.Count == 0)
        {
            <div class="text-center py-5">
                <h5>No conversations yet</h5>
                <p class="text-muted mb-0"> Your conversations will appear here. </p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush"> @foreach (var contact in Model)
                {
                    <a asp-controller="Message" asp-action="Chat" asp-route-contactId="@contact.ContactId"
                       class="list-group-item list-group-item-action p-3">

                        <div class="d-flex align-items-center gap-3">
                            
                            <img src="@(string.IsNullOrWhiteSpace(contact.ContactProfilePicture) 
                                        ? "/images/default-profile.png" : contact.ContactProfilePicture)"
                                alt="@contact.ContactDetails" class="rounded-circle flex-shrink-0"
                                style="width: 55px; height: 55px; object-fit: cover;"
                                onerror="this.onerror=null;this.src='/images/default-profile.png';"/>

                            <div class="flex-grow-1 min-width-0">
                                <h6
                                    class="mb-1 fw-semibold"> @contact.ContactDetails 
                                </h6>
                                <small class="text-muted">Open conversation </small></div>

                            <div class="text-end">
                                <small class="text-muted text-nowrap">
                                    Last Message:
                                    <br>
                                    @contact.LastMessage.ToLocalTime().ToString("dd MMM, HH:mm")
                                </small>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>


