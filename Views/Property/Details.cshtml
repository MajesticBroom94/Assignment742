@using Assignment742.Domain.Enums
@using Assignment742.Extensions
@model PropertyDetailsViewModel

@{
    ViewData["Title"] = Model.Title;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var showBooking = !isAuthenticated || User.IsInRole("Guest");

    Layout = showBooking ? "_HomeLayout" : "_HostLayout";

    var images = (Model.ImageUrls ?? new List<string>())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();

    var visibleImages = images.Take(5).ToList();
    var averageRating = Model.ReviewContent.Any()
        ? Model.ReviewContent.Average(r => r.Rating)
        : (double?)null;

    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var nextDate = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<link rel="stylesheet" href="~/css/propertyDetails.css"/>
<link rel="stylesheet" href="~/css/popup.css"/>

@if (TempData["BookingError"] != null)
{
    <div class="custom-popup custom-popup-error" role="alert">
        <div class="custom-popup-icon"><i class="fa fa-exclamation-circle"></i></div>
        <div class="custom-popup-content"><strong>Booking error</strong><span>@TempData["BookingError"]</span></div>
    </div>
}
@if (TempData["BookingConfirmation"] != null)
{
    <div class="custom-popup custom-popup-success" role="status">
        <div class="custom-popup-icon"><i class="fa fa-check-circle"></i></div>
        <div class="custom-popup-content"><strong>Booking
                confirmed</strong><span>@TempData["BookingConfirmation"]</span></div>
    </div>
}

<main class="pd-page">
    <section class="pd-hero" aria-labelledby="property-title">
        <div class="pd-hero-photo">
            @if (images.Count > 0)
            {
                <img src="@images[0]" alt="@Model.Title"/>
            }
            else
            {
                <div class="pd-photo-empty"><i class="fa fa-image" aria-hidden="true"></i><span>No property photos available</span>
                </div>
            }
        </div>
        <div class="pd-hero-body">
            <div class="pd-eyebrow">Your next stay</div>
            <h1 id="property-title">@Model.Title</h1>
            <p class="pd-address"><i class="fa fa-map-marker" aria-hidden="true"></i> @Model.Address</p>
            <div class="pd-hero-stats">
                <span><i class="fa fa-users" aria-hidden="true"></i> @Model.MaxGuests guests</span>
                <span><i class="fa fa-bed" aria-hidden="true"></i> @Model.Bedrooms bedrooms</span>
                <span><i class="fa fa-bed" aria-hidden="true"></i> @Model.Beds beds</span>
                <span><i class="fa fa-bath" aria-hidden="true"></i> @Model.Bathrooms bathrooms</span>
                <span><i class="fas fa-home" aria-hidden="true"></i>@EnumExtension.GetDisplayName(Model.PropertyType)</span>
            </div>
            <div class="pd-hero-footer">
                <div class="pd-social-proof">
                    <span><i class="fa fa-star" aria-hidden="true"></i> @Model.Reviews reviews</span>
                    <span><i class="fa fa-calendar-check-o" aria-hidden="true"></i> @Model.Bookings bookings</span>
                </div>
                <div class="pd-hero-price"><strong>R @Model.PricePerNight.ToString("N2")</strong><span> / night</span>
                </div>
            </div>
        </div>
    </section>

    <section class="pd-gallery-section" aria-labelledby="gallery-heading">
        <div class="pd-section-heading">
            <h2 id="gallery-heading">Explore the space</h2>
            <span>@images.Count @(images.Count == 1 ? "photo" : "photos")</span>
        </div>
        @if (images.Count > 0)
        {
            <div class="pd-gallery @(visibleImages.Count == 1 ? "pd-gallery-single" : "")">
                @for (var i = 0; i < visibleImages.Count; i++)
                {
                    <button type="button" class="pd-gallery-item @(i == 0 ? "pd-gallery-featured" : "")"
                            data-image-index="@i" aria-label="View photo @(i + 1) of @images.Count">
                        <img src="@visibleImages[i]" alt="@Model.Title photo @(i + 1)"
                             loading="@(i == 0 ? "eager" : "lazy")"/>
                        @if (i == 4 && images.Count > 5)
                        {
                            <span class="pd-more-photos">+@(images.Count - 5) more</span>
                        }
                    </button>
                }
            </div>
            <button class="pd-gallery-all" type="button" id="viewAllPhotos"><i class="fa fa-th" aria-hidden="true"></i>
                View all photos
            </button>
        }
        else
        {
            <div class="pd-gallery-placeholder">Photos haven't been added for this property yet.</div>
        }
    </section>

    <div class="pd-content-grid @(showBooking ? "" : "pd-content-grid-full")">
        <div class="pd-main-content">
            <section class="pd-panel pd-host" aria-labelledby="host-heading">
                <div class="pd-host-identity">
                    @if (!string.IsNullOrWhiteSpace(Model.HostProfilePicture))
                    {
                        <img class="pd-host-avatar" src="@Model.HostProfilePicture"
                             alt="Profile photo of @Model.HostName" loading="lazy"/>
                    }
                    else
                    {
                        <span class="pd-host-avatar pd-avatar-placeholder" aria-hidden="true"><i class="fa fa-user"></i></span>
                    }
                    <div><h2 id="host-heading">Hosted
                            by @(string.IsNullOrWhiteSpace(Model.HostName) ? "your host" : Model.HostName)</h2>
                        <p>Your property host</p></div>
                </div>
            </section>

            <section class="pd-panel" aria-labelledby="description-heading">
                <h2 id="description-heading">About this place</h2>
                <p class="pd-description">@Model.Description</p>
                <div class="pd-facts">
                    <div>
                        
                        <i class="fa fa-users" aria-hidden="true"></i>
                        <span><strong>@Model.MaxGuests</strong> guests</span>
                    </div>
                    <div>
                        <i class="fa fa-bed" aria-hidden="true"></i>
                        <span><strong>@Model.Beds</strong> beds</span>
                    </div>
                    <div>
                        
                        <i class="fa fa-home" aria-hidden="true"></i>
                        <span><strong>@Model.Bedrooms</strong> bedrooms</span>
                    </div>
                    <div>
                        <i class="fa fa-bath" aria-hidden="true"></i>
                        <span><strong>@Model.Bathrooms</strong> bathrooms</span>
                    </div>
                </div>
            </section>
            
            <section class="pd-panel" aria-labelledby="amenities-heading">
                <h2 id="amenities-heading">What this place offers</h2>
                @if (Model.Amenities.Any())
                {
                    <div class="pd-amenities">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <div class="pd-amenity">
                                <i class="@amenity.IconClass" aria-hidden="true"></i>
                                <span>@amenity.Name</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="pd-muted">No amenities have been listed yet.</p>
                }
            </section>
            
            <section class="pd-panel" aria-labelledby="reviews-heading">
                <div class="pd-section-heading">
                    <h2 id="reviews-heading"><i class="fa fa-star pd-star" aria-hidden="true"></i> Guest reviews</h2>
                    <span>@Model.Reviews total</span>
                </div>
                @if (averageRating.HasValue)
                {
                    <p class="pd-review-overview"><strong>@averageRating.Value.ToString("0.0") / 5</strong> average
                        rating
                        from @Model.ReviewContent.Count displayed @(Model.ReviewContent.Count == 1 ? "review" : "reviews")
                    </p>
                }
                @if (Model.ReviewContent.Any())
                {
                    <div class="pd-reviews">
                        @foreach (var review in Model.ReviewContent)
                        {
                            <article class="pd-review">
                                <div class="pd-review-header">
                                    <div>
                                        
                                        <strong>@(review.Reviewer.FirstName + " " + review.Reviewer.LastName)</strong><span>@review.CreatedAt.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <span class="pd-rating" aria-label="@review.Rating out of 5 stars"><i
                                            class="fa fa-star" aria-hidden="true"></i> @review.Rating/5</span>
                                </div>
                                <p>@review.Comment</p>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="pd-muted">No written reviews are available yet.</p>
                }
            </section>
        </div>

        @if (showBooking)
        {
            <aside class="pd-booking" aria-labelledby="booking-title">
                <div class="pd-booking-price"><strong>R @Model.PricePerNight.ToString("N2")</strong><span> / night</span>
                </div>
                <h2 id="booking-title">Reserve your stay</h2>
                <form method="post" asp-controller="Booking" asp-action="Create" id="bookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.Id" id="propertyId"/>
                    <div class="pd-date-grid">
                        <div>
                            <label for="checkInDate">Check-in</label>
                            <input type="date" class="form-control"
                                   id="checkInDate" name="CheckInDate"
                                   min="@minDate" value="@minDate" required/>
                        </div>
                        <div>
                            <label for="checkOutDate">Check-out</label>
                            <input type="date" class="form-control"
                                   id="checkOutDate" name="CheckOutDate"
                                   min="@nextDate" value="@nextDate" required/>
                        </div>
                    </div>
                    <div id="availabilityMessage" class="pd-availability" role="status" aria-live="polite"></div>
                    <div class="pd-guest-row">
                        <div><strong>Guests</strong><small>Maximum @Model.MaxGuests</small></div>
                        <div class="pd-counter">
                            <button type="button" id="decrementGuestButton" aria-label="Decrease guests">−</button>
                            <output id="guestQuantity">1</output>
                            <button type="button" id="incrementGuestButton" aria-label="Increase guests">+</button>
                        </div>
                    </div>
                    @* Preserves the existing booking POST fields. Confirm whether your Create action accepts guest count before adding a named input. *@
                    <fieldset class="pd-payment">
                        <legend>Payment options</legend>
                        <label class="pd-payment-option" id="payNowRadioContent">
                        
                            <input type="radio" name="PaymentOption"
                                   value="@PaymentStatus.Completed"
                                   id="payNow" checked required/>
                            <span><strong>Pay now</strong>
                                <small>
                                    <span id="payNowAmount">R 0.00</span> charged today</small></span>
                        </label>
                    
                        <label class="pd-payment-option" id="payLaterRadioContent"><input type="radio" name="PaymentOption"
                                                                                          value="@PaymentStatus.PayLater"
                                                                                          id="payLater"
                                                                                          required/><span><strong>Pay later</strong><small><span
                                        id="payLaterAmount">R 0.00</span> due 7 days before check-in</small></span></label>
                    </fieldset>
                    <div class="pd-price-breakdown">
                        <h3>Price details</h3>
                        <div><span id="accommodationCostDetails">Accommodation</span><span
                                id="accommodationCost">R 0.00</span></div>
                        <div><span>Service fee (10%)</span><span id="serviceFee">R 0.00</span></div>
                        <div class="pd-price-total"><strong>Total</strong><strong id="costBreakdownTotal">R 0.00</strong>
                        </div>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="submit" class="pd-reserve-btn" id="reserveButton" disabled>Reserve now</button>
                    }
                    else
                    {
                        <a class="pd-reserve-btn" asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path">Log in to reserve</a>
                    }
                    <p class="pd-booking-note">Availability is checked for your selected dates.</p>
                </form>
            </aside>
        }
    </div>
</main>

@if (images.Count > 0)
{
    <div class="pd-lightbox" id="propertyLightbox" role="dialog" aria-modal="true" aria-label="Property photos"
         aria-hidden="true" hidden>
        <div class="pd-lightbox-toolbar"><span id="lightboxCounter"></span>
            <button type="button" id="lightboxClose" aria-label="Close gallery">&times;</button>
        </div>
        <button type="button" class="pd-lightbox-arrow pd-lightbox-prev" id="lightboxPrevious"
                aria-label="Previous photo">&#10094;
        </button>
        <img id="lightboxImage" alt="Property photo"/>
        <button type="button" class="pd-lightbox-arrow pd-lightbox-next" id="lightboxNext" aria-label="Next photo">
            &#10095;
        </button>
    </div>
}

<script src="~/js/popup.js"></script>
<script src="~/js/fetchCheckinProcess.js"></script>
<script>
    (() => {
        const photos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(images));
        const lightbox = document.getElementById('propertyLightbox');
        if (lightbox && photos.length) {
            let index = 0;
            let previousFocus = null;
            const image = document.getElementById('lightboxImage');
            const counter = document.getElementById('lightboxCounter');
            const closeButton = document.getElementById('lightboxClose');

            function updateImage() {
                image.src = photos[index];
                image.alt = `Property photo ${index + 1} of ${photos.length}`;
                counter.textContent = `${index + 1} / ${photos.length}`;
            }

            function openGallery(selected) {
                previousFocus = document.activeElement;
                index = selected;
                updateImage();
                lightbox.hidden = false;
                lightbox.setAttribute('aria-hidden', 'false');
                document.body.classList.add('pd-modal-open');
                closeButton.focus();
            }

            function closeGallery() {
                lightbox.hidden = true;
                lightbox.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('pd-modal-open');
                previousFocus?.focus();
            }

            function step(delta) {
                index = (index + delta + photos.length) % photos.length;
                updateImage();
            }

            document.querySelectorAll('[data-image-index]').forEach(button => button.addEventListener('click', () => openGallery(Number(button.dataset.imageIndex))));
            document.getElementById('viewAllPhotos')?.addEventListener('click', () => openGallery(0));
            closeButton.addEventListener('click', closeGallery);
            document.getElementById('lightboxPrevious').addEventListener('click', () => step(-1));
            document.getElementById('lightboxNext').addEventListener('click', () => step(1));
            lightbox.addEventListener('click', event => {
                if (event.target === lightbox) closeGallery();
            });
            document.addEventListener('keydown', event => {
                if (lightbox.hidden) return;
                if (event.key === 'Escape') closeGallery();
                if (event.key === 'ArrowLeft') step(-1);
                if (event.key === 'ArrowRight') step(1);
                if (event.key === 'Tab') {
                    event.preventDefault();
                    closeButton.focus();
                }
            });
        }

        // Only the Guest/anonymous layout contains the booking form.
        // Keep gallery interactions available to everyone.
        if (!document.getElementById('bookingForm')) return;

        const pricePerNight = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PricePerNight));
        const maxGuests = @Model.MaxGuests;
        const checkIn = document.getElementById('checkInDate');
        const checkOut = document.getElementById('checkOutDate');
        const availability = document.getElementById('availabilityMessage');
        const reserve = document.getElementById('reserveButton');
        const minus = document.getElementById('decrementGuestButton');
        const plus = document.getElementById('incrementGuestButton');
        const quantity = document.getElementById('guestQuantity');
        const payNow = document.getElementById('payNow');
        const payLater = document.getElementById('payLater');
        const money = value => 'R ' + value.toLocaleString('en-ZA', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
        let guests = 1;
        let requestVersion = 0;
        let availableForDates = false;

        function updateGuests() {
            guests = Math.max(1, Math.min(guests, Math.max(1, maxGuests)));
            quantity.textContent = guests;
            minus.disabled = guests <= 1;
            plus.disabled = guests >= maxGuests;
        }

        minus.addEventListener('click', () => {
            guests--;
            updateGuests();
        });
        plus.addEventListener('click', () => {
            guests++;
            updateGuests();
        });
        updateGuests();

        const dayNumber = dateString => Date.parse(dateString + 'T00:00:00Z') / 86400000;

        function nightsSelected() {
            if (!checkIn.value || !checkOut.value || checkIn.value < checkIn.min || checkOut.value <= checkIn.value) return 0;
            return Math.max(0, dayNumber(checkOut.value) - dayNumber(checkIn.value));
        }

        function updatePrice() {
            const nights = nightsSelected();
            const accommodation = nights * pricePerNight;
            const fee = accommodation * 0.10;
            const total = accommodation + fee;
            document.getElementById('accommodationCostDetails').textContent = `${money(pricePerNight)} × ${nights} ${nights === 1 ? 'night' : 'nights'}`;
            document.getElementById('accommodationCost').textContent = money(accommodation);
            document.getElementById('serviceFee').textContent = money(fee);
            document.getElementById('costBreakdownTotal').textContent = money(total);
            document.getElementById('payNowAmount').textContent = money(total);
            document.getElementById('payLaterAmount').textContent = money(total);
            const daysToArrival = checkIn.value ? dayNumber(checkIn.value) - dayNumber(checkIn.min) : -1;
            const canPayLater = nights > 0 && daysToArrival >= 7;
            document.getElementById('payLaterRadioContent').hidden = !canPayLater;
            payLater.disabled = !canPayLater;
            if (!canPayLater && payLater.checked) payNow.checked = true;
        }

        function setAvailability(message, state) {
            availability.textContent = message;
            availability.className = 'pd-availability' + (state ? ` pd-availability-${state}` : '');
            availableForDates = state === 'success';
            if (reserve) reserve.disabled = !availableForDates;
        }

        async function checkAvailability() {
            const version = ++requestVersion;
            const nights = nightsSelected();
            if (!nights) {
                setAvailability('Choose valid check-in and check-out dates.', 'error');
                return;
            }
            setAvailability('Checking availability…', 'pending');
            const params = new URLSearchParams({
                PropertyId: document.getElementById('propertyId').value,
                CheckInDate: checkIn.value,
                CheckOutDate: checkOut.value
            });
            try {
                const response = await fetch(`/Booking/CheckAvailability?${params}`, {headers: {Accept: 'application/json'}});
                if (!response.ok) throw new Error('Availability request failed');
                const result = await response.json();
                if (version !== requestVersion) return;
                setAvailability(result.message || (result.available ? 'Available for your dates.' : 'Not available for these dates.'), result.available ? 'success' : 'error');
            } catch {
                if (version === requestVersion) setAvailability('Unable to check availability. Please try again.', 'error');
            }
        }

        function updateDates() {
            if (checkIn.value) {
                const next = new Date(checkIn.value + 'T12:00:00');
                next.setDate(next.getDate() + 1);
                checkOut.min = `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}-${String(next.getDate()).padStart(2, '0')}`;
            }
            updatePrice();
            checkAvailability();
        }

        checkIn.addEventListener('change', updateDates);
        checkOut.addEventListener('change', updateDates);
        document.getElementById('bookingForm').addEventListener('submit', event => {
            if (!availableForDates || !nightsSelected() || !payNow.checked && !payLater.checked) event.preventDefault();
        });
        updateDates();
        if (typeof closePopup === 'function') closePopup();
    })();
</script>
