@model List<PropertyGuestViewModel>

@{
    ViewData["Title"] = "staybnb";
    Layout = "_HomeLayout";
}

<link rel="stylesheet" href="~/css/guestLayout.css">

<section class="properties-page">

    <div class="properties-intro">
        <h2>Relax. Unwind. Choose your next stay</h2>
    </div>

    <div class="properties-grid" id="propertiesGrid">

        @foreach (var property in Model)
        {
            <article class="property-card"
                     data-title="@property.Title.ToLowerInvariant()"
                     data-location="@property.Address.ToLowerInvariant()">

                <button type="button"
                        class="property-favorite @(property.IsFavorite ? "active" : "")"
                        aria-label="Add to favourites"
                        title="Add to favourites"
                        onclick="wishlistManager(@property.Id, this)">
                    @if (property.IsFavorite)
                    {
                        <span>♥</span>
                    }
                    else
                    {
                        <span>♡</span>
                    }
                    
                </button>

                <a asp-controller="Property"
                   asp-action="Details"
                   asp-route-id="@property.Id"
                   class="property-image-link">

                    <img src="@property.ImageUrl"
                         alt="@property.Title"
                         class="property-image"
                         loading="lazy"
                         onerror="this.onerror=null;this.src='https://placehold.co/600x500/f5f5f5/777?text=Property+Image';" />
                </a>

                <div class="property-details">

                    <div class="property-details-top">
                        <h3 class="property-title"
                            title="@property.Title">
                            @property.Title
                        </h3>

                        <div class="property-rating">
                            <span>★</span>@property.Rating?.ToString("0.0")
                        </div>
                    </div>

                    <p class="property-location">
                        @property.Address
                    </p>

                    <p class="property-reviews">
                        @property.ReviewCount?.ToString("N0") reviews
                    </p>

                    <p class="property-price">
                        <strong>
                            @property.PricePerNight.ToString("C0",
                                System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                        </strong>
                        <span>per night</span>
                    </p>

                </div>
            </article>
        }

        @if (!Model.Any())
        {
            <div class="properties-empty">
                <h3>No properties available</h3>
                <p>There are currently no properties to display. Please check back later.</p>
            </div>
        }

    </div>
</section>
