
@using Assignment742.Domain.Enums
@using Assignment742.Domain.Models
@model UpdatePropertyViewModel

@{
    ViewData["Title"] = "Update Property";
    Layout = "_HostLayout";
}

<div class="container py-4">

    <h2 class="mb-4">Update Property</h2>

    <form id="updatePropertyForm"
          asp-action="Update"
          asp-route-propertyId="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <!-- BASIC INFORMATION -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Basic Information</h5>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Type" class="form-label">
                            Property Type
                        </label>

                        <select asp-for="Type"
                                asp-items="Html.GetEnumSelectList<PropertyType>()"
                                class="form-select">
                            <option value="">-- Select Type --</option>
                        </select>

                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PricePerNight" class="form-label">
                            Price Per Night
                        </label>

                        <input asp-for="PricePerNight"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="PricePerNight"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

            </div>
        </div>

        <!-- CAPACITY -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Property Capacity</h5>
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-md-3 col-6 mb-3">
                        <label asp-for="MaxGuests" class="form-label"></label>
                        <input asp-for="MaxGuests"
                               class="form-control"
                               min="1" max="50" />
                        <span asp-validation-for="MaxGuests"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 col-6 mb-3">
                        <label asp-for="Bedrooms" class="form-label"></label>
                        <input asp-for="Bedrooms"
                               class="form-control"
                               min="1" max="50" />
                        <span asp-validation-for="Bedrooms"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 col-6 mb-3">
                        <label asp-for="Beds" class="form-label"></label>
                        <input asp-for="Beds"
                               class="form-control"
                               min="1" max="50" />
                        <span asp-validation-for="Beds"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 col-6 mb-3">
                        <label asp-for="Bathrooms" class="form-label"></label>
                        <input asp-for="Bathrooms"
                               class="form-control"
                               min="1" max="50" />
                        <span asp-validation-for="Bathrooms"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- AMENITIES -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Amenities</h5>
            </div>

            <div class="card-body">

                <div class="row">
                    @foreach (Amenity amenity in ViewBag.AvailableAmenities)
                    {
                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="form-check">

                                <input type="checkbox"
                                       class="form-check-input"
                                       name="AmenityIds"
                                       value="@amenity.Id"
                                       id="amenity_@amenity.Id"
                                       checked="@(Model.AmenityIds.Contains(amenity.Id))" />

                                <label class="form-check-label"
                                       for="amenity_@amenity.Id">
                                    <i class="@amenity.IconClass me-1"></i>
                                    @amenity.Name
                                </label>

                            </div>
                        </div>
                    }
                </div>

                <span asp-validation-for="AmenityIds"
                      class="text-danger"></span>

            </div>
        </div>

        <!-- IMAGES -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Property Images</h5>
            </div>

            <div class="card-body">

                <h6>Current Pictures</h6>

                @if (Model.ExistingImageUrls.Any())
                {
                    <div class="d-flex flex-wrap gap-3 mb-3">

                        @foreach (var imageUrl in Model.ExistingImageUrls)
                        {
                            <img src="@imageUrl"
                                 alt="Property image"
                                 class="rounded border"
                                 style="width:150px;
                                        height:110px;
                                        object-fit:cover;" />
                        }

                    </div>
                }
                else
                {
                    <p class="text-muted">
                        No existing pictures available.
                    </p>
                }

                <label asp-for="Images" class="form-label">
                    Replace Property Pictures
                </label>

                <input asp-for="Images"
                       type="file"
                       multiple
                       accept="image/*"
                       class="form-control" />

                <div class="form-text">
                    Leave empty to keep the existing pictures.
                    Uploading new pictures will replace all existing pictures.
                </div>

                <span asp-validation-for="Images"
                      class="text-danger"></span>

            </div>
        </div>

        <!-- CHECK-IN INSTRUCTIONS -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Check-in Instructions</h5>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <label asp-for="CheckInProcessTitle"
                           class="form-label">
                        Instructions Title
                    </label>

                    <input asp-for="CheckInProcessTitle"
                           class="form-control" />

                    <span asp-validation-for="CheckInProcessTitle"
                          class="text-danger"></span>
                </div>

                <input asp-for="CheckInProcessJson" type="hidden" />

                <span asp-validation-for="CheckInProcessJson"
                      class="text-danger"></span>

                <p id="stepSummary" class="text-muted mb-2">
                    No check-in steps added.
                </p>

                <button type="button"
                        class="btn btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#checkInModal">
                    Manage Check-in Steps
                </button>

            </div>
        </div>

        <!-- SUBMIT -->
        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

        </div>

    </form>
</div>


<!-- CHECK-IN STEPS MODAL -->
<div class="modal fade"
     id="checkInModal"
     tabindex="-1"
     aria-labelledby="checkInModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="checkInModalLabel">
                    Manage Check-in Steps
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <p class="text-muted">
                    Add or modify the instructions guests should follow.
                </p>

                <div id="checkInSteps"></div>

                <button type="button"
                        class="btn btn-outline-primary mt-2"
                        id="addStepBtn">
                    + Add Step
                </button>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary"
                        data-bs-dismiss="modal">
                    Done
                </button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/updatePropertyCheckinSteps.js"></script>
}
