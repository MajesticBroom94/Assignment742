@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="container text-center mt-5">
    <h1 class="display-1 fw-bold text-danger">
        @ViewBag.StatusCode
    </h1>

    <h3>@ViewBag.Message</h3>

    <p class="text-muted">
        Please return to the home page or try again.
    </p>

    <a asp-controller="Account" asp-action="Index" class="btn btn-primary mt-3">
        Back to Home
    </a>
</div>

