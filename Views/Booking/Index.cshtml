@using Assignment742.Domain.Enums
@using Assignment742.Extensions
@model ICollection<BookingViewModel>

@{
    var isGuest = false;
    
    if (User.IsInRole("Guest"))
    {
        ViewBag.Title = "My Bookings";
        Layout = "_GuestLayout";
        isGuest = true;
    }
    else
    {
        ViewBag.Title = "All Bookings";
        Layout = "_AdminLayout";
    }
    
    var today = DateTime.Today;
}

<link rel="stylesheet" href="~/css/bookingRequest.css" />
<link rel="stylesheet" href="~/css/booking.css" />
<link rel="stylesheet" href="~/css/bookingPopups.css" />

<div class="booking-page">

    <div class="booking-page-header">
        <div>
            <h3>Bookings</h3>
            <p>Manage your reservations, payments and check-ins</p>
        </div>

        <span class="booking-count">
            <i class="fa-regular fa-calendar"></i>
            @(Model.Count == 1 ? Model.Count + " booking" : Model.Count + " bookings" )  
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="booking-alert success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="booking-alert error">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="booking-empty">
            <i class="fa-regular fa-calendar-xmark"></i>
            <h4>No Bookings Found</h4>
            <p>You haven't made any reservations yet.</p>
        </div>
    }
    else
    {
        @foreach (var booking in Model)
        {
            var isApproved = booking.BookingStatus == BookingStatus.Approved;

            var isPaid = booking.PaymentStatus == PaymentStatus.Completed;

            var canPay = booking.PaymentStatus == PaymentStatus.PayLater;

            var hasPendingCheckinStatus = booking.CheckInStatus == CheckInStatus.Pending;

            var isCheckedIn = booking.CheckInStatus == CheckInStatus.CheckedIn;

            var isCheckedOut = booking.CheckInStatus == CheckInStatus.CheckedOut;

            var inDateRange = today >= booking.CheckInDate.Date &&
                              today <= booking.CheckOutDate.Date;

            var canCheckIn = isApproved && hasPendingCheckinStatus &&
                             isPaid && inDateRange && booking.HasValidGuestDocument;

            var canCheckOut = isApproved &&
                              isPaid &&
                              inDateRange &&
                              isCheckedIn;

            <div class="booking-card">

                <div class="booking-card-header">
                    <div>
                        <h4>@booking.PropertyTitle</h4>

                        <span class="booking-address">
                            <i class="fa-solid fa-location-dot"></i>
                            @booking.PropertyAddress
                        </span>
                    </div>

                    <span class="guest-booking-status">
                        @EnumExtension.GetDisplayName(
                            booking.BookingStatus)
                    </span>
                </div>

                <div class="booking-card-body">

                    <!-- HOST DETAILS -->
                    <div class="booking-section">

                        <span class="booking-section-title">
                            Host Information
                        </span>

                        <div class="booking-detail">
                            <i class="fa-regular fa-user"></i>
                            <div>
                                <small>Property Host</small>
                                <strong>@booking.HostDetails</strong>
                            </div>
                        </div>

                        <div class="booking-detail">
                            <i class="fa-regular fa-envelope"></i>
                            <div>
                                <small>Email Address</small>
                                <span>@booking.HostEmail</span>
                            </div>
                        </div>
                        
                        <!-- Creation -->
                        <span class="booking-section-title">
                            Booking Date
                        </span>

                        <div class="booking-detail">
                            <i class="fa-regular fa-clock"></i>
                            <div>
                                <small>Time</small>
                                <strong>@booking.BookingDate.ToString("dd MMM yyyy")</strong>
                            </div>
                        </div>

                    </div>

                    <!-- RESERVATION DETAILS -->
                    <div class="booking-section">

                        <span class="booking-section-title">
                            Reservation Details
                        </span>
                        
                        <div class="booking-detail">
                            <i class="fa-regular fa-user"></i>
                            <div>
                                <small>Booking Guest</small>
                                <strong>@booking.guestDetails</strong>
                            </div>
                        </div>

                        <div class="booking-detail">
                            <i class="fa-regular fa-envelope"></i>
                            <div>
                                <small>Email Address</small>
                                <span>@booking.guestEmail</span>
                            </div>
                        </div>

                        <div class="booking-dates">

                            <div class="booking-detail">
                                <i class="fa-solid fa-calendar-check"></i>
                                <div>
                                    <small>Check-in</small>
                                    <strong>
                                        @booking.CheckInDate.ToString("dd MMM yyyy")
                                    </strong>
                                </div>
                            </div>

                            <div class="booking-detail">
                                <i class="fa-solid fa-calendar-xmark"></i>
                                <div>
                                    <small>Check-out</small>
                                    <strong>
                                        @booking.CheckOutDate.ToString("dd MMM yyyy")
                                    </strong>
                                </div>
                            </div>

                        </div>

                        <div class="booking-payment">
                            <span>Payment Status</span>

                            <span class="payment-badge">
                                @EnumExtension.GetDisplayName(
                                    booking.PaymentStatus)
                            </span>
                            
                            <span class="vr"></span>
                            
                            <span>Check-in Status</span>
                            
                            <span class="payment-badge">
                                @(booking.CheckInStatus.HasValue
                                    ? EnumExtension.GetDisplayName(
                                        booking.CheckInStatus.Value)
                                    : "Not Started")
                            </span>
                        </div>

                        

                    </div>

                </div>

                <!-- ACTIONS -->
                <div class="booking-card-footer guest-booking-footer">
                    
                    <!-- LEFT: Document controls -->
                    <div class="booking-document-actions">
                        @if (isGuest && isApproved && booking.CheckInStatus == CheckInStatus.Pending)
                            {
                                @if (booking.HasValidGuestDocument)
                                {
                                    <span class="document-status approved">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Document Approved
                                    </span>
                                }
                                else if (!booking.HasGuestDocument)
                                {
                                    <button type="button"
                                            class="booking-button document-button"
                                            onclick="openDocumentPopup(@booking.BookingId)">
                                        <i class="fa-solid fa-file-arrow-up"></i>
                                        Upload Document
                                    </button>
                                }
                                else if (booking.LatestDocumentStatus == DocumentStatus.Invalid)
                                {
                                    <span class="document-status rejected">
                                        <i class="fa-solid fa-circle-xmark"></i>
                                        Document Rejected
                                    </span>

                                    <button type="button"
                                            class="booking-button document-button"
                                            onclick="openDocumentPopup(@booking.BookingId)">
                                        <i class="fa-solid fa-rotate"></i>
                                        Reupload
                                    </button>
                                }
                                else
                                {
                                    <span class="document-status pending">
                                        <i class="fa-solid fa-clock"></i>
                                        Awaiting Document Verification
                                    </span>
                                }
                            }
                    </div>


                    <!-- RIGHT: Existing booking actions -->
                    <div class="booking-actions guest-booking-actions">

                        @if (isGuest)
                        {
                            <!-- MESSAGE HOST -->
                            <a class="booking-button message-button"
                               asp-controller="Message"
                               asp-action="Chat"
                               asp-route-contactId="@booking.HostId">
                                <i class="fa-regular fa-comment-dots"></i>
                                Message Host
                            </a>

                            <!-- PAYMENT -->
                            @if (canPay)
                            {
                                <form asp-controller="Booking" asp-action="ProcessPayment" method="post"
                                      onsubmit="return confirm('Confirm payment for this booking?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="bookingId"
                                           value="@booking.BookingId"/>

                                    <button type="submit"
                                            class="booking-button pay-button">
                                        <i class="fa-regular fa-credit-card"></i>
                                        Pay Now
                                    </button>
                                </form>
                            }

                            <!-- VIEW CHECK-IN PROCESS -->
                            @if (isApproved)
                            {
                                <button type="button"
                                        class="booking-button process-button"
                                        onclick="showCheckinSteps(@booking.BookingId)">
                                    <i class="fa-solid fa-list-check"></i>
                                    View Check-in Process
                                </button>
                            }

                            <!-- LEAVE REVIEW -->
                            @if (isCheckedOut)
                            {
                                <button type="button" class="booking-button review-button"
                                        onclick="openReviewPopup(@booking.BookingId)">
                                    <i class="fa-regular fa-star"></i>
                                    Leave Review
                                </button>
                            }

                            <!-- CHECK-IN -->
                            @if (canCheckIn)
                            {
                                <form asp-controller="Booking" asp-action="CheckIn" method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="bookingId"
                                           value="@booking.BookingId"/>

                                    <button type="submit" class="booking-button checkin-button">
                                        <i class="fa-solid fa-door-open"></i>
                                        Check In
                                    </button>
                                </form>
                            }

                            <!-- CHECK-OUT -->
                            @if (canCheckOut)
                            {
                                <form asp-controller="Booking" asp-action="CheckOut" method="post"
                                      onsubmit="return confirm('Confirm your checkout?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="bookingId"
                                           value="@booking.BookingId"/>

                                    <button type="submit"
                                            class="booking-button checkout-button">
                                        <i class="fa-solid fa-right-from-bracket"></i>
                                        Check Out
                                    </button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<div id="bookingPopup" class="booking-popup-overlay" hidden>
    <div class="booking-popup" role="dialog"
         aria-modal="true"
         aria-labelledby="popupTitle">

        <div class="booking-popup-header">
            <h4 id="popupTitle"></h4>

            <button type="button"
                    class="popup-close"
                    onclick="closeBookingPopup()"
                    aria-label="Close">
                &times;
            </button>
        </div>

        <div id="popupContent"></div>
    </div>
</div>


@if (isGuest)
{
    <div id="reviewPopup" class="booking-popup-overlay" hidden>
        <div class="booking-popup" role="dialog" aria-modal="true" aria-labelledby="reviewPopupTitle">
            <div class="booking-popup-header">
                <h4 id="reviewPopupTitle">Leave a Review</h4>
                <button type="button" class="popup-close" onclick="closeModal('reviewPopup')" aria-label="Close">&times;</button>
            </div>
            <form asp-controller="Review" asp-action="SubmitReview" method="post" class="popup-review-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BookingId" id="reviewBookingId" />
                <label for="reviewRating">Rating</label>
                <select id="reviewRating" name="Rating" required>
                    <option value="">Select rating</option>
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Average</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Very Poor</option>
                </select>
                <label for="reviewComment">Your review</label>
                <textarea id="reviewComment" name="Comment" rows="5" maxlength="1000"
                          placeholder="Write your review..." required></textarea>
                <button type="submit" class="booking-button review-button">Submit Review</button>
            </form>
        </div>
    </div>

    <div id="documentPopup" class="booking-popup-overlay" hidden>
        
        <div class="booking-popup" role="dialog" aria-modal="true" aria-labelledby="documentPopupTitle">
            <div class="booking-popup-header">
                <h4 id="documentPopupTitle">Upload Check-in Document</h4>
                <button type="button" class="popup-close" onclick="closeModal('documentPopup')" aria-label="Close">&times;</button>
            </div>

            <form asp-controller="Booking" asp-action="UploadGuestDocument" method="post"
                  enctype="multipart/form-data" class="popup-review-form">
                
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="documentBookingId"/>
                
                <label for="documentType">Document type</label>
                <input type="text" id="documentType" name="documentType" maxlength="100"
                       placeholder="e.g. Identification" required/>
                
                <label for="guestDocument">Choose a PDF or image (max 5 MB)</label>
                <input type="file" id="guestDocument" name="document" accept=".pdf,.jpg,.jpeg,.png" required/>
                <p class="document-privacy-note">Only upload documents needed for check-in.</p>
                
                <button type="submit" class="booking-button process-button">Upload Document</button>
            </form>
        </div>
    </div>
}

<script src="~/js/bookingPopupDialog.js"></script>
